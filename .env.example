# AegisGateway Environment Variables
NODE_ENV=development
PORT=3000

# Upstream LLM Provider API Keys (Optional - deterministic simulator works out of the box without keys)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Gateway Configuration
AEGIS_DEFAULT_CACHE_THRESHOLD=0.92
AEGIS_DEFAULT_RPM_LIMIT=600
AEGIS_DEFAULT_TPM_LIMIT=500000
AEGIS_CIRCUIT_FAILURE_THRESHOLD=0.5
AEGIS_CIRCUIT_COOLDOWN_MS=15000
AEGIS_CIRCUIT_P95_LATENCY_THRESHOLD_MS=3000

# Multi-Tenancy & Cryptographic Salt
AEGIS_KEY_SALT=aegis_sec_salt_prod_99f2a7
